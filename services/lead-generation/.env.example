# V2 Lead Generation - Production Environment Configuration
# Copy this file to .env and configure your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL Database Configuration (REQUIRED for production)
DB_HOST=localhost
DB_NAME=lead_generation_v2
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Optional: Custom database port
# DB_PORT=5432

# LinkedIn Data Scraper API (for future integration)
# LINKEDIN_API_KEY=your_linkedin_api_key_here
# LINKEDIN_API_URL=https://api.example.com

# Production Settings
ENVIRONMENT=production
LOG_LEVEL=INFO

# Trinity Collective Intelligence Settings
TEAM_MODE=enabled
COMM_FILE_PATH=../../agents/comm.json